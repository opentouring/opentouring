{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.opentouring.org/otwd/v1/site.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OTWD site",
  "description": "A site with every fact and its provenance: the full form served by the API with view=full and in GeoJSON bulk downloads. A site is a place a traveller stops at, with point geometry: its location. Each fact is an object holding its value and its provenance (the shared wrapper in common.schema.json), so the two always travel together, and facilities are facts of their own. A fact that is absent from the record is unknown. site-compact.schema.json describes the compact form.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/FullRecord"
    },
    {
      "description": "A site whose location is sensitive has no locality, because a locality can name a small place (ADR 0045).",
      "if": {
        "required": ["facts"],
        "properties": {
          "facts": {
            "required": ["location_sensitivity"],
            "properties": {
              "location_sensitivity": true
            }
          }
        }
      },
      "then": {
        "properties": {
          "derived": {
            "not": {
              "required": ["locality"],
              "properties": {
                "locality": true
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/SiteId"
    },
    "derived": {
      "$ref": "common.schema.json#/$defs/PointDerived"
    },
    "facts": {
      "$ref": "#/$defs/Facts"
    },
    "facilities": {
      "$ref": "#/$defs/FacilityFacts"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Facts": {
      "description": "The site's facts, each holding its value and provenance in the shared fact wrapper. The fact names and their value shapes are the same as in FactValues.",
      "type": "object",
      "properties": {
        "names": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Names"
            }
          }
        },
        "location": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/SiteLocation"
            }
          }
        },
        "site_types": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/SiteTypes"
            }
          }
        },
        "description": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Description"
            }
          }
        },
        "opening_hours": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/OpeningHours"
            }
          }
        },
        "reception_hours": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/OpeningHours"
            }
          }
        },
        "prices": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Prices"
            }
          }
        },
        "rig_limits": {
          "description": "Safety fact.",
          "x-otwd-safety-fact": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/RigLimits"
            }
          }
        },
        "access": {
          "description": "Safety fact.",
          "x-otwd-safety-fact": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Access"
            }
          }
        },
        "pets": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Pets"
            }
          }
        },
        "bait_notices": {
          "description": "Safety fact. Poison bait notices in or next to the site, recorded as the notice gives them with the authority's link, never as a live baiting programme. A bait can kill a dog, so every change needs a moderator.",
          "x-otwd-safety-fact": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/BaitNotices"
            }
          }
        },
        "accessibility": {
          "description": "Access for people with disability. Not a safety fact, but a change that raises access to yes goes to a person all the same (the accessibility_raised fixed check), because a wrong yes can strand a traveller who relied on it. The accessible_facilities facility is read from it.",
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/SiteAccessibility"
            }
          }
        },
        "bookings": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Bookings"
            }
          }
        },
        "contact": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Contact"
            }
          }
        },
        "capacity": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Capacity"
            }
          }
        },
        "stay_limits": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/StayLimits"
            }
          }
        },
        "fire_district": {
          "description": "Safety fact. Computed from the location against a seed source's fire district boundaries and recomputed whenever the location changes, so contributors never submit it. Its provenance names that seed source.",
          "x-otwd-safety-fact": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/FireDistrict"
            }
          }
        },
        "camping_rules": {
          "description": "Whether overnight camping is allowed, restricted or prohibited, under the council's or land manager's rules, with the authority and its link.",
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/CampingRules"
            }
          }
        },
        "permits": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Permits"
            }
          }
        },
        "quiet_hours": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/QuietHours"
            }
          }
        },
        "age_rules": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/AgeRules"
            }
          }
        },
        "firewood": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/Firewood"
            }
          }
        },
        "seasonal_operation": {
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/SeasonalOperation"
            }
          }
        },
        "tidal_access": {
          "description": "Safety fact. Reaching the site depends on the tide, with the tide authority's prediction page. A traveller caught by the tide can lose the vehicle, so every change needs a moderator.",
          "x-otwd-safety-fact": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/TidalAccess"
            }
          }
        },
        "water_notices": {
          "description": "Safety fact. Boil water and other water quality notices for the site's supply, as the water authority published them, with its link. Every change needs a moderator.",
          "x-otwd-safety-fact": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/WaterNotices"
            }
          }
        },
        "location_sensitivity": {
          "description": "The site's exact position is withheld and its published location generalised (ADR 0045). Not a safety fact, but every change to it is on the always-human list (x-otwd-always-human), because a wrong removal would publish a place its custodians asked to protect.",
          "x-otwd-always-human": true,
          "$ref": "common.schema.json#/$defs/Fact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/LocationSensitivity"
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/RequiredFacts"
        },
        {
          "$ref": "#/$defs/SensitiveLocationRule"
        }
      ]
    },
    "FactValues": {
      "description": "Every fact of a site as a plain value, without provenance: the facts of the compact form and of submissions. It sets no rule on unknown names, so each user closes it with unevaluatedProperties.",
      "type": "object",
      "properties": {
        "names": {
          "$ref": "values.schema.json#/$defs/Names"
        },
        "location": {
          "$ref": "values.schema.json#/$defs/SiteLocation"
        },
        "site_types": {
          "$ref": "values.schema.json#/$defs/SiteTypes"
        },
        "description": {
          "$ref": "values.schema.json#/$defs/Description"
        },
        "opening_hours": {
          "$ref": "values.schema.json#/$defs/OpeningHours"
        },
        "reception_hours": {
          "$ref": "values.schema.json#/$defs/OpeningHours"
        },
        "prices": {
          "$ref": "values.schema.json#/$defs/Prices"
        },
        "rig_limits": {
          "$ref": "values.schema.json#/$defs/RigLimits"
        },
        "access": {
          "$ref": "values.schema.json#/$defs/Access"
        },
        "pets": {
          "$ref": "values.schema.json#/$defs/Pets"
        },
        "bait_notices": {
          "$ref": "values.schema.json#/$defs/BaitNotices"
        },
        "accessibility": {
          "$ref": "values.schema.json#/$defs/SiteAccessibility"
        },
        "bookings": {
          "$ref": "values.schema.json#/$defs/Bookings"
        },
        "contact": {
          "$ref": "values.schema.json#/$defs/Contact"
        },
        "capacity": {
          "$ref": "values.schema.json#/$defs/Capacity"
        },
        "stay_limits": {
          "$ref": "values.schema.json#/$defs/StayLimits"
        },
        "fire_district": {
          "$ref": "values.schema.json#/$defs/FireDistrict"
        },
        "camping_rules": {
          "$ref": "values.schema.json#/$defs/CampingRules"
        },
        "permits": {
          "$ref": "values.schema.json#/$defs/Permits"
        },
        "quiet_hours": {
          "$ref": "values.schema.json#/$defs/QuietHours"
        },
        "age_rules": {
          "$ref": "values.schema.json#/$defs/AgeRules"
        },
        "firewood": {
          "$ref": "values.schema.json#/$defs/Firewood"
        },
        "seasonal_operation": {
          "$ref": "values.schema.json#/$defs/SeasonalOperation"
        },
        "tidal_access": {
          "$ref": "values.schema.json#/$defs/TidalAccess"
        },
        "water_notices": {
          "$ref": "values.schema.json#/$defs/WaterNotices"
        },
        "location_sensitivity": {
          "$ref": "values.schema.json#/$defs/LocationSensitivity"
        }
      }
    },
    "RequiredFacts": {
      "description": "The facts a site always has when it is not a stub (merged, replaced or retracted): names, location, site_types. Shared by the full form, the compact form and the submission that creates one.",
      "required": ["names", "location", "site_types"],
      "properties": {
        "names": true,
        "location": true,
        "site_types": true
      }
    },
    "FacilityFacts": {
      "description": "A map from facility code to a fact holding the facility value and its provenance, so each facility has its own provenance. Codes with defined attributes are checked against their per-code schema. The codes facilities.json marks with stored_as are read from other facts and never appear here. The anyOf lists exactly those codes, and tools/validate.py checks that the two agree.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/FacilityCode"
      },
      "not": {
        "anyOf": [
          {
            "required": ["pets_allowed"],
            "properties": {
              "pets_allowed": true
            }
          },
          {
            "required": ["dog_off_leash"],
            "properties": {
              "dog_off_leash": true
            }
          },
          {
            "required": ["big_rig_access"],
            "properties": {
              "big_rig_access": true
            }
          },
          {
            "required": ["accessible_facilities"],
            "properties": {
              "accessible_facilities": true
            }
          }
        ]
      },
      "properties": {
        "toilets": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/ToiletsValue"
            }
          }
        },
        "showers": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/ShowersValue"
            }
          }
        },
        "drinking_water": {
          "$ref": "#/$defs/FacilityFact",
          "x-otwd-safety-fact": true,
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/DrinkingWaterValue"
            }
          }
        },
        "non_potable_water": {
          "$ref": "#/$defs/FacilityFact",
          "x-otwd-safety-fact": true,
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/NonPotableWaterValue"
            }
          }
        },
        "power": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/PowerValue"
            }
          }
        },
        "dump_point_access": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/DumpPointAccessValue"
            }
          }
        },
        "bbq": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/BbqValue"
            }
          }
        },
        "fires_allowed": {
          "$ref": "#/$defs/FacilityFact",
          "x-otwd-safety-fact": true,
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/FiresAllowedValue"
            }
          }
        },
        "pool": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/PoolValue"
            }
          }
        },
        "laundry": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/LaundryValue"
            }
          }
        },
        "wifi": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/WifiValue"
            }
          }
        },
        "mobile_coverage": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/MobileCoverageValue"
            }
          }
        },
        "generators_allowed": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/GeneratorsAllowedValue"
            }
          }
        },
        "ensuite_pitches": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/CountedValue"
            }
          }
        },
        "cabins": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/CountedValue"
            }
          }
        },
        "drive_through_pitches": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/CountedValue"
            }
          }
        },
        "tent_pitches": {
          "$ref": "#/$defs/FacilityFact",
          "properties": {
            "value": {
              "$ref": "values.schema.json#/$defs/CountedValue"
            }
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/FacilityFact"
      }
    },
    "FacilityFact": {
      "description": "One facility as a fact: its value and its provenance, in the shared fact wrapper.",
      "$ref": "common.schema.json#/$defs/Fact",
      "properties": {
        "value": {
          "$ref": "values.schema.json#/$defs/FacilityValue"
        }
      }
    },
    "SensitiveLocationRule": {
      "description": "A site with a location_sensitivity fact publishes a generalised location, and only such a site does (ADR 0045). The compact form applies the same rule to plain values in CompactSensitiveLocationRule, and tools/validate.py checks that the coordinates sit on the grid the reason allows.",
      "if": {
        "required": ["location_sensitivity"],
        "properties": {
          "location_sensitivity": true
        }
      },
      "then": {
        "properties": {
          "location": {
            "properties": {
              "value": {
                "required": ["generalised"],
                "properties": {
                  "generalised": true
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "location": {
            "properties": {
              "value": {
                "not": {
                  "required": ["generalised"],
                  "properties": {
                    "generalised": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "CompactSensitiveLocationRule": {
      "description": "SensitiveLocationRule for plain values: the compact form and the facts of a GeoJSON feature's compact properties.",
      "if": {
        "required": ["location_sensitivity"],
        "properties": {
          "location_sensitivity": true
        }
      },
      "then": {
        "properties": {
          "location": {
            "required": ["generalised"],
            "properties": {
              "generalised": true
            }
          }
        },
        "not": {
          "required": ["locality"],
          "properties": {
            "locality": true
          }
        }
      },
      "else": {
        "properties": {
          "location": {
            "not": {
              "required": ["generalised"],
              "properties": {
                "generalised": true
              }
            }
          }
        }
      }
    }
  }
}
