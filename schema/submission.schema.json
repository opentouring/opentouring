{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.opentouring.org/otwd/v1/submission.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OTWD submission",
  "description": "A proposed change to a record (a site, road restriction, road segment or ferry service) sent by a contributor, as a partner app or the Open Touring website posts it to POST /v1/submissions. Each record type has its own kind for creating a record. The kinds that change an existing record work for every record type and name it in record_id, whose kind segment gives the record type. A submission never changes live data directly. It enters the submission log, passes fixed checks, AI review and routing, and becomes a change only after an approving moderation decision. Contributors are identified by an OTWD contributor ID or a partner app's pseudonymous ID, never by name or email.",
  "type": "object",
  "required": ["schema_version", "kind", "contributor_submitted_at", "consent", "proposed"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_site",
        "new_road_restriction",
        "new_road_segment",
        "new_ferry_service",
        "update_facts",
        "add_photo",
        "report_closure",
        "request_merge",
        "report_problem"
      ]
    },
    "record_id": {
      "description": "The record the submission is about, of any record type. Every kind that changes an existing record names it here. Absent for the kinds that create a record.",
      "$ref": "common.schema.json#/$defs/RecordId"
    },
    "base_change_seq": {
      "description": "The record's change_seq as the contributor last saw it. OTWD compares it with the change_seq of every fact the submission touches and rejects the submission with 409 when one of them changed since. Required for update_facts, report_closure and request_merge.",
      "$ref": "common.schema.json#/$defs/ChangeSeq"
    },
    "contributor": {
      "$ref": "#/$defs/ContributorClaim"
    },
    "seed_record": {
      "$ref": "#/$defs/SeedRecord"
    },
    "partner_app_id": {
      "description": "The partner app sending the submission. Optional, because OTWD takes it from the API key. When present it must match the key.",
      "$ref": "common.schema.json#/$defs/PartnerAppId"
    },
    "consent": {
      "$ref": "#/$defs/Consent"
    },
    "contributor_submitted_at": {
      "description": "When the contributor made the submission in the partner app or on the website, which may be long before it reaches OTWD when the device was offline.",
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "observed_on": {
      "description": "The date the contributor observed what they report. Defaults to the date of contributor_submitted_at.",
      "$ref": "common.schema.json#/$defs/LocalDate"
    },
    "partner_reference": {
      "description": "The partner app's own reference for this submission, returned in status responses and webhooks.",
      "type": "string",
      "maxLength": 100
    },
    "note_to_moderators": {
      "description": "Optional context for moderators. Not published.",
      "type": "string",
      "maxLength": 1000
    },
    "proposed": {
      "description": "The proposed values. The shape depends on kind."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "A submission comes from a contributor or, for OTWD's own seeding pipeline only, from a seed source record.",
      "oneOf": [
        {
          "required": ["contributor"],
          "properties": {
            "contributor": true
          }
        },
        {
          "required": ["seed_record"],
          "properties": {
            "seed_record": true
          }
        }
      ]
    },
    {
      "description": "towing_permitted comes from contributors, so a seeding pipeline submission never proposes it.",
      "if": {
        "required": ["seed_record"],
        "properties": {
          "seed_record": true
        }
      },
      "then": {
        "properties": {
          "proposed": {
            "properties": {
              "facts": {
                "properties": {
                  "towing_permitted": false
                }
              }
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "$ref": "#/$defs/NewSiteSubmission"
        },
        {
          "$ref": "#/$defs/NewRoadRestrictionSubmission"
        },
        {
          "$ref": "#/$defs/NewRoadSegmentSubmission"
        },
        {
          "$ref": "#/$defs/NewFerryServiceSubmission"
        },
        {
          "$ref": "#/$defs/UpdateFactsSubmission"
        },
        {
          "$ref": "#/$defs/AddPhotoSubmission"
        },
        {
          "$ref": "#/$defs/ReportClosureSubmission"
        },
        {
          "$ref": "#/$defs/RequestMergeSubmission"
        },
        {
          "$ref": "#/$defs/ReportProblemSubmission"
        }
      ]
    }
  ],
  "$defs": {
    "ContributorClaim": {
      "description": "Who the contributor is. direct: a direct contributor signed in to Open Touring. pseudonymous: a contributor of the partner app holding the API key, identified by the partner app's stable pseudonymous ID for them.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "contributor_id"],
          "properties": {
            "kind": {
              "const": "direct"
            },
            "contributor_id": {
              "$ref": "common.schema.json#/$defs/ContributorId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "pseudonymous_id"],
          "properties": {
            "kind": {
              "const": "pseudonymous"
            },
            "pseudonymous_id": {
              "description": "Stable for one contributor within one partner app and meaningless outside it, for example a salted hash of the partner app's internal account number. The character set excludes @ so an email address can never be sent by mistake.",
              "type": "string",
              "pattern": "^[A-Za-z0-9._~-]{8,128}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SeedRecord": {
      "description": "The seed source record a seeding pipeline submission comes from. Accepted only from API keys that belong to OTWD's own pipelines.",
      "type": "object",
      "required": ["seed_source_id", "record_id"],
      "properties": {
        "seed_source_id": {
          "$ref": "common.schema.json#/$defs/SeedSourceId"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dataset_version": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "Consent": {
      "description": "The contributor terms the contributor accepted. Partner apps must obtain this consent from each contributor before submitting on their behalf.",
      "type": "object",
      "required": ["terms_version", "accepted_at"],
      "properties": {
        "terms_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "accepted_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "SiteFacts": {
      "description": "Proposed site facts, as plain values without provenance. OTWD records provenance when the change is applied. fire_district is computed from the location, so it is never submitted.",
      "$ref": "site.schema.json#/$defs/FactValues",
      "properties": {
        "fire_district": false
      },
      "unevaluatedProperties": false
    },
    "RoadRestrictionFacts": {
      "description": "Proposed road restriction facts, as plain values without provenance. OTWD records provenance when the change is applied.",
      "$ref": "road-restriction.schema.json#/$defs/FactValues",
      "unevaluatedProperties": false
    },
    "RoadSegmentFacts": {
      "description": "Proposed road segment facts, as plain values without provenance. OTWD records provenance when the change is applied.",
      "$ref": "road-segment.schema.json#/$defs/FactValues",
      "unevaluatedProperties": false
    },
    "FerryServiceFacts": {
      "description": "Proposed ferry service facts, as plain values without provenance. OTWD records provenance when the change is applied.",
      "$ref": "ferry-service.schema.json#/$defs/FactValues",
      "unevaluatedProperties": false
    },
    "NoTarget": {
      "description": "A submission that creates a record names no existing record and has no base_change_seq.",
      "not": {
        "anyOf": [
          {
            "required": ["record_id"],
            "properties": {
              "record_id": true
            }
          },
          {
            "required": ["base_change_seq"],
            "properties": {
              "base_change_seq": true
            }
          }
        ]
      }
    },
    "ExistingRecordTarget": {
      "description": "A submission about an existing record names it in record_id.",
      "required": ["record_id"],
      "properties": {
        "record_id": true
      }
    },
    "NewSiteSubmission": {
      "properties": {
        "kind": {
          "const": "new_site"
        },
        "proposed": {
          "type": "object",
          "required": ["facts"],
          "properties": {
            "facts": {
              "$ref": "#/$defs/SiteFacts",
              "allOf": [
                {
                  "$ref": "site.schema.json#/$defs/RequiredFacts"
                }
              ]
            },
            "facilities": {
              "$ref": "values.schema.json#/$defs/StoredFacilities"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/NoTarget"
        }
      ],
      "required": ["kind", "proposed"]
    },
    "NewRoadRestrictionSubmission": {
      "properties": {
        "kind": {
          "const": "new_road_restriction"
        },
        "proposed": {
          "type": "object",
          "required": ["facts"],
          "properties": {
            "facts": {
              "$ref": "#/$defs/RoadRestrictionFacts",
              "allOf": [
                {
                  "$ref": "road-restriction.schema.json#/$defs/RequiredFacts"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/NoTarget"
        }
      ],
      "required": ["kind", "proposed"]
    },
    "NewRoadSegmentSubmission": {
      "properties": {
        "kind": {
          "const": "new_road_segment"
        },
        "proposed": {
          "type": "object",
          "required": ["facts"],
          "properties": {
            "facts": {
              "$ref": "#/$defs/RoadSegmentFacts",
              "allOf": [
                {
                  "$ref": "road-segment.schema.json#/$defs/RequiredFacts"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/NoTarget"
        }
      ],
      "required": ["kind", "proposed"]
    },
    "NewFerryServiceSubmission": {
      "properties": {
        "kind": {
          "const": "new_ferry_service"
        },
        "proposed": {
          "type": "object",
          "required": ["facts"],
          "properties": {
            "facts": {
              "$ref": "#/$defs/FerryServiceFacts",
              "allOf": [
                {
                  "$ref": "ferry-service.schema.json#/$defs/RequiredFacts"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/NoTarget"
        }
      ],
      "required": ["kind", "proposed"]
    },
    "UpdateFactsSubmission": {
      "properties": {
        "kind": {
          "const": "update_facts"
        },
        "proposed": {
          "description": "Facts and facilities to set, and facts or facilities to remove because they are no longer true. To record that a facility is absent, set it with available false rather than removing it. Which facts are allowed depends on the record type named by record_id, and only sites have facilities.",
          "type": "object",
          "properties": {
            "facts": {
              "type": "object",
              "minProperties": 1
            },
            "facilities": {
              "$ref": "values.schema.json#/$defs/StoredFacilities",
              "minProperties": 1
            },
            "remove": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/FieldPointer"
              }
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": ["facts"],
              "properties": {
                "facts": true
              }
            },
            {
              "required": ["facilities"],
              "properties": {
                "facilities": true
              }
            },
            {
              "required": ["remove"],
              "properties": {
                "remove": true
              }
            }
          ]
        },
        "record_id": true,
        "base_change_seq": true
      },
      "required": ["kind", "proposed", "base_change_seq"],
      "allOf": [
        {
          "$ref": "#/$defs/ExistingRecordTarget"
        }
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/SiteFactsUpdate"
        },
        {
          "$ref": "#/$defs/RoadRestrictionFactsUpdate"
        },
        {
          "$ref": "#/$defs/RoadSegmentFactsUpdate"
        },
        {
          "$ref": "#/$defs/FerryServiceFactsUpdate"
        }
      ]
    },
    "SiteFactsUpdate": {
      "description": "update_facts on a site: site facts and facilities. The facts every site has cannot be removed.",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/SiteId"
        },
        "proposed": {
          "properties": {
            "facts": {
              "$ref": "#/$defs/SiteFacts"
            },
            "remove": {
              "items": {
                "not": {
                  "enum": ["/facts/names", "/facts/location", "/facts/site_types"]
                }
              }
            }
          }
        }
      }
    },
    "RoadRestrictionFactsUpdate": {
      "description": "update_facts on a road restriction. The facts every road restriction has cannot be removed, and there are no facilities.",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/RoadRestrictionId"
        },
        "proposed": {
          "$ref": "#/$defs/RecordFactsOnly",
          "properties": {
            "facts": {
              "$ref": "#/$defs/RoadRestrictionFacts"
            },
            "remove": {
              "items": {
                "not": {
                  "enum": ["/facts/location", "/facts/structure"]
                }
              }
            }
          }
        }
      }
    },
    "RoadSegmentFactsUpdate": {
      "description": "update_facts on a road segment. The facts every road segment has cannot be removed, and there are no facilities.",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/RoadSegmentId"
        },
        "proposed": {
          "$ref": "#/$defs/RecordFactsOnly",
          "properties": {
            "facts": {
              "$ref": "#/$defs/RoadSegmentFacts"
            },
            "remove": {
              "items": {
                "not": {
                  "enum": ["/facts/geometry"]
                }
              }
            }
          }
        }
      }
    },
    "FerryServiceFactsUpdate": {
      "description": "update_facts on a ferry service. The facts every ferry service has cannot be removed, and there are no facilities.",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/FerryServiceId"
        },
        "proposed": {
          "$ref": "#/$defs/RecordFactsOnly",
          "properties": {
            "facts": {
              "$ref": "#/$defs/FerryServiceFacts"
            },
            "remove": {
              "items": {
                "not": {
                  "enum": [
                    "/facts/names",
                    "/facts/geometry",
                    "/facts/terminals",
                    "/facts/accepted_vehicle_classes"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "RecordFactsOnly": {
      "description": "The proposed changes for a record that is not a site: facts only, never facilities.",
      "properties": {
        "remove": {
          "items": {
            "pattern": "^/facts/"
          }
        }
      },
      "not": {
        "required": ["facilities"],
        "properties": {
          "facilities": true
        }
      }
    },
    "AddPhotoSubmission": {
      "properties": {
        "kind": {
          "const": "add_photo"
        },
        "proposed": {
          "description": "A photo already uploaded through POST /v1/photo-uploads, of any record type, such as a site, the clearance sign at a road restriction or the towing sign on a road segment. The photographer licenses it under CC BY 4.0.",
          "type": "object",
          "required": ["upload_id", "licence", "attribution"],
          "properties": {
            "upload_id": {
              "$ref": "common.schema.json#/$defs/UploadId"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/Sha256"
            },
            "caption": {
              "$ref": "common.schema.json#/$defs/Notes"
            },
            "taken_on": {
              "$ref": "common.schema.json#/$defs/LocalDate"
            },
            "licence": {
              "const": "CC-BY-4.0"
            },
            "attribution": {
              "description": "The credit the photographer wants shown, such as a display name or handle. Never an email address.",
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^@]+$"
            }
          },
          "additionalProperties": false
        },
        "record_id": true
      },
      "required": ["kind", "proposed"],
      "allOf": [
        {
          "$ref": "#/$defs/ExistingRecordTarget"
        }
      ]
    },
    "ReportClosureSubmission": {
      "properties": {
        "kind": {
          "const": "report_closure"
        },
        "proposed": {
          "description": "A report that the record has closed, closed for a time, or reopened (status active). For a road restriction, closed means the limit no longer applies, such as when the structure was replaced.",
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["temporarily_closed", "closed", "active"]
            },
            "reason": {
              "$ref": "common.schema.json#/$defs/Notes"
            },
            "reopens_on": {
              "$ref": "common.schema.json#/$defs/LocalDate"
            },
            "closed_on": {
              "$ref": "common.schema.json#/$defs/LocalDate"
            },
            "closure_authority": {
              "$ref": "common.schema.json#/$defs/ClosureAuthority"
            },
            "closure_info_url": {
              "$ref": "common.schema.json#/$defs/ClosureInfoUrl"
            }
          },
          "additionalProperties": false
        },
        "record_id": true,
        "base_change_seq": true
      },
      "allOf": [
        {
          "$ref": "#/$defs/ExistingRecordTarget"
        }
      ],
      "required": ["kind", "proposed", "base_change_seq"]
    },
    "RequestMergeSubmission": {
      "properties": {
        "kind": {
          "const": "request_merge"
        },
        "proposed": {
          "description": "A request to merge the submission's record with one or more records of the same record type that the contributor believes are the same thing. A moderator chooses the surviving record.",
          "type": "object",
          "required": ["duplicate_record_ids", "reason"],
          "properties": {
            "duplicate_record_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/RecordId"
              }
            },
            "suggested_survivor": {
              "$ref": "common.schema.json#/$defs/RecordId"
            },
            "reason": {
              "$ref": "common.schema.json#/$defs/Notes"
            }
          },
          "additionalProperties": false
        },
        "record_id": true,
        "base_change_seq": true
      },
      "allOf": [
        {
          "$ref": "#/$defs/ExistingRecordTarget"
        }
      ],
      "required": ["kind", "proposed", "base_change_seq"]
    },
    "ReportProblemSubmission": {
      "properties": {
        "kind": {
          "const": "report_problem"
        },
        "proposed": {
          "description": "A problem a moderator should look at that the contributor cannot fix with another kind of submission.",
          "type": "object",
          "required": ["category", "details"],
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "wrong_location",
                "does_not_exist",
                "safety_hazard",
                "inappropriate_photo",
                "copied_content",
                "private_property",
                "personal_information",
                "other"
              ]
            },
            "details": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2000
            },
            "fields": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/FieldPointer"
              }
            },
            "photo_id": {
              "$ref": "common.schema.json#/$defs/PhotoId"
            }
          },
          "additionalProperties": false
        },
        "record_id": true
      },
      "allOf": [
        {
          "$ref": "#/$defs/ExistingRecordTarget"
        }
      ],
      "required": ["kind", "proposed"]
    }
  }
}
