{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.opentouring.org/otwd/v1/road-restriction-compact.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OTWD road restriction, compact form",
  "description": "A road restriction with plain values and no per-fact provenance: the default form served by the API (view=compact) and the column layout of GeoParquet bulk downloads. It is derived from the full form (road-restriction.schema.json) by replacing each fact with its value, in the same way as the compact site form.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/CompactRecord"
    },
    {
      "$ref": "common.schema.json#/$defs/PointDerivedValues"
    },
    {
      "$ref": "road-restriction.schema.json#/$defs/FactValues"
    },
    {
      "if": {
        "properties": {
          "status": {
            "$ref": "common.schema.json#/$defs/StubStatus"
          }
        }
      },
      "else": {
        "allOf": [
          {
            "$ref": "road-restriction.schema.json#/$defs/RequiredFacts"
          }
        ],
        "required": ["country_code", "time_zone"],
        "properties": {
          "country_code": true,
          "time_zone": true
        }
      }
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/RoadRestrictionId"
    }
  },
  "unevaluatedProperties": false
}
