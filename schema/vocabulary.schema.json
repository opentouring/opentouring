{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.opentouring.org/otwd/v1/vocabulary.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OTWD governed list",
  "description": "The format of the governed lists (site-types.json, facilities.json, structures.json, surfaces.json, vehicle-access-classes.json and vehicle-classes.json) and of the API responses that serve them. Codes are stable: a code is never renamed or reused. A code that is no longer wanted is marked deprecated and keeps its meaning.",
  "type": "object",
  "required": ["$schema", "list", "version", "language", "entries"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "$comment": {
      "type": "string"
    },
    "list": {
      "type": "string",
      "enum": [
        "site_types",
        "facilities",
        "structures",
        "surfaces",
        "vehicle_access_classes",
        "vehicle_classes"
      ]
    },
    "version": {
      "description": "Version of the governed list. A new entry increases the minor version. Changing an entry's meaning is not allowed.",
      "$ref": "#/$defs/ListVersion"
    },
    "language": {
      "description": "Language of labels and descriptions in this file. Translations are published as separate files.",
      "$ref": "common.schema.json#/$defs/LanguageTag"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "list": {
            "const": "site_types"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/SiteTypeEntry"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "list": {
            "const": "facilities"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/FacilityEntry"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "list": {
            "enum": ["surfaces", "vehicle_classes"]
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/PlainEntry"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "list": {
            "const": "structures"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/StructureEntry"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "list": {
            "const": "vehicle_access_classes"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/RankedEntry"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ListVersion": {
      "description": "A governed list version: major.minor.patch.",
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "Entry": {
      "type": "object",
      "required": ["code", "label", "description", "status", "introduced_in", "osm", "schema_org"],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/Code"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated"]
        },
        "introduced_in": {
          "$ref": "#/$defs/ListVersion"
        },
        "replaced_by": {
          "$ref": "common.schema.json#/$defs/Code"
        },
        "safety_fact": {
          "description": "True when the entry is a safety fact, which routing always sends to a moderator. Used by site types and facilities. In the other lists the fact that holds the code says whether it is a safety fact.",
          "type": "boolean"
        },
        "osm": {
          "description": "The closest OpenStreetMap tagging. An empty list means OSM has no established equivalent.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tags", "match"],
            "properties": {
              "tags": {
                "description": "One or more key=value tags that together express the entry.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_:]+=[^=\\s][^=]*$"
                }
              },
              "match": {
                "description": "exact: same meaning. broader: the OSM tagging covers more than the entry. narrower: it covers less. related: useful but not equivalent.",
                "type": "string",
                "enum": ["exact", "broader", "narrower", "related"]
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            },
            "additionalProperties": false
          }
        },
        "schema_org": {
          "description": "The closest schema.org type or property, or null when there is none.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["match"],
              "properties": {
                "type": {
                  "description": "A schema.org type, for example Campground.",
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z]+$"
                },
                "property": {
                  "description": "A schema.org property, for example amenityFeature.",
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z]+$"
                },
                "value": {
                  "description": "The value to use with the property, for example the LocationFeatureSpecification name.",
                  "type": "string",
                  "maxLength": 100
                },
                "match": {
                  "type": "string",
                  "enum": ["exact", "broader", "narrower", "related"]
                },
                "note": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": ["type"],
                  "properties": {
                    "type": true
                  }
                },
                {
                  "required": ["property"],
                  "properties": {
                    "property": true
                  }
                }
              ]
            }
          ]
        }
      },
      "description": "The fields every governed list entry has. Each list's entry definition adds its own fields and closes the entry with unevaluatedProperties."
    },
    "SiteTypeEntry": {
      "description": "An entry in the site type list.",
      "$ref": "#/$defs/Entry",
      "properties": {
        "group": {
          "type": "string",
          "enum": ["overnight", "utility", "services", "attraction", "emergency", "transport"]
        },
        "defers_to": {
          "description": "For a site type whose detailed data lives outside OTWD: what OTWD records and where the rest comes from.",
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["group"],
      "unevaluatedProperties": false
    },
    "FacilityEntry": {
      "description": "An entry in the facility list, with its attributes.",
      "$ref": "#/$defs/Entry",
      "properties": {
        "attributes": {
          "description": "The attributes the facility carries. They are validated by the facility's schema in values.schema.json.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "description"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "type": {
                "type": "string",
                "enum": ["boolean", "integer", "number", "string", "enum", "time", "list"]
              },
              "unit": {
                "type": "string",
                "maxLength": 20
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string",
                "maxLength": 300
              }
            },
            "additionalProperties": false
          }
        },
        "stored_as": {
          "description": "For a facility read from another fact rather than stored in the facilities map: a JSON Pointer to that fact and the rule.",
          "type": "object",
          "required": ["field", "rule"],
          "properties": {
            "field": {
              "type": "string",
              "format": "json-pointer"
            },
            "rule": {
              "type": "string",
              "maxLength": 300
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["safety_fact"],
      "unevaluatedProperties": false
    },
    "PlainEntry": {
      "description": "An entry in a list whose codes carry no attributes: surfaces and vehicle classes.",
      "$ref": "#/$defs/Entry",
      "unevaluatedProperties": false
    },
    "StructureEntry": {
      "description": "An entry in the structure list. passages lists how a road can pass the structure (over, under, through or along), and a road restriction's passage must be one of them.",
      "$ref": "#/$defs/Entry",
      "properties": {
        "passages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["over", "under", "through", "along"]
          }
        }
      },
      "required": ["passages"],
      "unevaluatedProperties": false
    },
    "RankedEntry": {
      "description": "An entry in an ordered list: vehicle access classes. rank orders the entries from the least to the most restrictive, so a filter can match every class up to the one a vehicle can handle.",
      "$ref": "#/$defs/Entry",
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": ["rank"],
      "unevaluatedProperties": false
    }
  }
}
