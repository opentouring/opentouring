{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.opentouring.org/otwd/v1/vocabulary.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OTWD governed list",
  "description": "The format of site-types.json and facilities.json, and of the GET /v1/site-types and GET /v1/facilities responses. Codes are stable: a code is never renamed or reused. A code that is no longer wanted is marked deprecated and keeps its meaning.",
  "type": "object",
  "required": ["$schema", "list", "version", "language", "entries"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "$comment": { "type": "string" },
    "list": { "type": "string", "enum": ["site_types", "facilities"] },
    "version": {
      "description": "Version of the governed list. A new entry increases the minor version. Changing an entry's meaning is not allowed.",
      "$ref": "#/$defs/ListVersion"
    },
    "language": {
      "description": "Language of labels and descriptions in this file. Translations are published as separate files.",
      "$ref": "common.schema.json#/$defs/LanguageTag"
    },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Entry" } }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "list": { "const": "site_types" } } },
      "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/SiteTypeEntry" } } } }
    },
    {
      "if": { "properties": { "list": { "const": "facilities" } } },
      "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/FacilityEntry" } } } }
    }
  ],
  "$defs": {
    "ListVersion": {
      "description": "A governed list version: major.minor.patch.",
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "Entry": {
      "type": "object",
      "required": ["code", "label", "description", "status", "introduced_in", "osm", "schema_org"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/Code" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "deprecated"] },
        "introduced_in": { "$ref": "#/$defs/ListVersion" },
        "replaced_by": { "$ref": "common.schema.json#/$defs/Code" },
        "safety_fact": {
          "description": "True when the entry is a safety fact, which routing always sends to a moderator.",
          "type": "boolean"
        },
        "osm": {
          "description": "The closest OpenStreetMap tagging. An empty list means OSM has no established equivalent.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tags", "match"],
            "properties": {
              "tags": {
                "description": "One or more key=value tags that together express the entry.",
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^[a-z0-9_:]+=[^=\\s][^=]*$" }
              },
              "match": {
                "description": "exact: same meaning. broader: the OSM tagging covers more than the entry. narrower: it covers less. related: useful but not equivalent.",
                "type": "string",
                "enum": ["exact", "broader", "narrower", "related"]
              },
              "note": { "type": "string", "maxLength": 300 }
            },
            "additionalProperties": false
          }
        },
        "schema_org": {
          "description": "The closest schema.org type or property, or null when there is none.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["match"],
              "properties": {
                "type": {
                  "description": "A schema.org type, for example Campground.",
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z]+$"
                },
                "property": {
                  "description": "A schema.org property, for example amenityFeature.",
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z]+$"
                },
                "value": {
                  "description": "The value to use with the property, for example the LocationFeatureSpecification name.",
                  "type": "string",
                  "maxLength": 100
                },
                "match": { "type": "string", "enum": ["exact", "broader", "narrower", "related"] },
                "note": { "type": "string", "maxLength": 300 }
              },
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": ["type"],
                  "properties": { "type": true }
                },
                {
                  "required": ["property"],
                  "properties": { "property": true }
                }
              ]
            }
          ]
        }
      }
    },
    "SiteTypeEntry": {
      "type": "object",
      "properties": {
        "code": true,
        "label": true,
        "description": true,
        "status": true,
        "introduced_in": true,
        "replaced_by": true,
        "safety_fact": true,
        "osm": true,
        "schema_org": true,
        "group": {
          "type": "string",
          "enum": ["overnight", "utility", "services", "attraction", "emergency"]
        },
        "defers_to": {
          "description": "For a site type whose detailed data lives outside OTWD: what OTWD records and where the rest comes from.",
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["group"],
      "additionalProperties": false
    },
    "FacilityEntry": {
      "type": "object",
      "properties": {
        "code": true,
        "label": true,
        "description": true,
        "status": true,
        "introduced_in": true,
        "replaced_by": true,
        "safety_fact": true,
        "osm": true,
        "schema_org": true,
        "attributes": {
          "description": "The attributes the facility carries. They are validated by the facility's schema in values.schema.json.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
              "type": {
                "type": "string",
                "enum": ["boolean", "integer", "number", "string", "enum", "time", "list"]
              },
              "unit": { "type": "string", "maxLength": 20 },
              "values": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string", "maxLength": 300 }
            },
            "additionalProperties": false
          }
        },
        "stored_as": {
          "description": "For a facility read from another fact rather than stored in the facilities map: a JSON Pointer to that fact and the rule.",
          "type": "object",
          "required": ["field", "rule"],
          "properties": {
            "field": { "type": "string", "format": "json-pointer" },
            "rule": { "type": "string", "maxLength": 300 }
          },
          "additionalProperties": false
        }
      },
      "required": ["safety_fact"],
      "additionalProperties": false
    }
  }
}
