{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$base": "../valid/location-sensitivity-reviewed.moderation-decision.json",
  "$patch": [
    {
      "op": "replace",
      "path": "/decided_by",
      "value": {
        "kind": "routing_rule",
        "rule_id": "auto_approve.trusted_contributor",
        "rule_version": "1"
      }
