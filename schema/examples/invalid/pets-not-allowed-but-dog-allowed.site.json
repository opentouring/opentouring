{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$base": "../valid/caravan-park-nt.site.json",
  "$patch": [
    {
      "op": "replace",
      "path": "/facts/pets/value/allowed",
      "value": "no"
    },
    {
      "op": "replace",
      "path": "/facts/pets/value/species",
      "value": [
        {
          "species": "dog",
          "allowed": "on_leash"
        }
      ]
    },
    {
      "op": "remove",
      "path": "/facts/pets/value/conditions"
    }
  ]
}
